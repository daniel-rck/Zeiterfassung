{
  "name": "zeiterfassung",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "description": "Schlanke, lokale Browser-PWA für Zeiterfassung — Timer, Projekte, Reports und Rechnungen, ohne Account, alles im Browser.",
  "keywords": [
    "zeiterfassung",
    "time-tracking",
    "pwa",
    "react",
    "indexeddb",
    "cloudflare-workers",
    "local-first"
  ],
  "author": "Daniel Rück",
  "homepage": "https://zeiterfassung.daniel-rck.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel-rck/Zeiterfassung.git"
  },
  "bugs": {
    "url": "https://github.com/daniel-rck/Zeiterfassung/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/workers-types": "^4.20260504.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/ui": "^4.1.5",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^29.1.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5",
    "workbox-precaching": "^7.4.0",
    "workbox-window": "^7.4.0",
    "wrangler": "^4.0.0"
  }
}
