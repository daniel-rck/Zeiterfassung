{
  "name": "zeiterfassung",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "description": "Schlanke, lokale Browser-PWA für Zeiterfassung — Timer, Projekte, Reports und Rechnungen, ohne Account, alles im Browser.",
  "keywords": [
    "zeiterfassung",
    "time-tracking",
    "pwa",
    "react",
    "indexeddb",
    "cloudflare-workers",
    "local-first"
  ],
  "author": "Daniel Rück",
  "homepage": "https://zeiterfassung.daniel-rck.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel-rck/Zeiterfassung.git"
  },
  "bugs": {
    "url": "https://github.com/daniel-rck/Zeiterfassung/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20260922.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-precaching": "^7.4.1",
    "wrangler": "^4.136.3"
  },
  "webBase": {
    "version": "0.3.1"
  }
}
